# Copy to .env; never commit real credentials.
CLOUDFLARE_ACCOUNT_ID=
# Use an API token authorized for Workers, Containers, R2 and Secrets Store,
# or omit this after configuring and logging into Alchemy.
CLOUDFLARE_API_TOKEN=
# Generate a separate random value for each with: openssl rand -hex 32
MINEFLARE_SETUP_TOKEN=
ALCHEMY_PASSWORD=
ALCHEMY_STATE_TOKEN=
